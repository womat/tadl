# systemd unit for tadl.
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin tadl
#   sudo usermod -aG gpio tadl
#   sudo install -d -o root -g root -m 0755 /opt/tadl /opt/tadl/bin
#   sudo install -d -o root -g tadl -m 0750 /opt/tadl/etc
#   sudo install -o root -g root -m 0755 tadl /opt/tadl/bin/tadl
#   sudo install -o root -g tadl -m 0640 config/config.yaml /opt/tadl/etc/config.yaml
#   sudo cp contrib/tadl.service /etc/systemd/system/
#   sudo /opt/tadl/bin/tadl token add browser
#   sudo systemctl enable --now tadl
#
# Everything under /opt/tadl belongs to root; the group tadl may only read etc/.
# tadl writes nothing to disk, so the service user needs no write access anywhere -
# and must not have it: whoever can write config.yaml or the token file can add a
# token of their own, and whoever can write bin/tadl can replace the program.
# key.pem goes in as root:tadl 0640, cert.pem as 0644.
#
# "systemctl reload tadl" rereads config.yaml and the token file. A config that does
# not load or validate ends tadl with exit code 78, and RestartPreventExitStatus
# keeps systemd from restarting it until the file is fixed: "systemctl status tadl"
# shows why.
#
# The sandbox: tadl needs the network (MQTT, HTTPS) and the GPIO character device,
# nothing else. "systemd-analyze security tadl" rates the result.

[Unit]
Description=tadl - DL-Bus of Technische Alternative controllers to MQTT and HTTPS
Documentation=https://github.com/womat/tadl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tadl
Group=tadl
ExecStart=/opt/tadl/bin/tadl
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Only the GPIO chip; PrivateDevices=yes would hide it.
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
